{
  "name": "wyntn-monorepo",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "packages/*",
    "apps/observer-ui"
  ],
  "scripts": {
    "test": "tsx --test packages/backend/cli/*.test.ts packages/observer-ui/tests/*.test.tsx",
    "news:run": "tsx packages/backend/cli/news-run.ts",
    "news:fetch": "tsx packages/backend/cli/news-fetch.ts",
    "mmge:run": "tsx packages/backend/cli/mmge-run.ts",
    "site:export": "tsx packages/backend/cli/site-export.ts",
    "push:today": "bash scripts/push-today.sh",
    "dev:observer": "pnpm --filter observer-ui dev"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  }
}
